# === Identifiants API Navis N4 (Basic Auth) ===
# Copie ce fichier en ".env" et renseigne tes valeurs :
#     cp .env.example .env
# Le fichier .env n'est JAMAIS versionne (voir .gitignore).

N4_USER=
N4_PASSWORD=

# URL de l'API N4 (adapte serveur/port et les coordonnees de scope a ton installation)
N4_URL=http://SERVEUR:PORT/apex/api/query?filtername=units_1&operatorId=OPERATEUR&complexId=COMPLEXE&facilityId=TERMINAL&yardId=PARC
